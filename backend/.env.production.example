# Copy to .env.production. Keep actual credentials out of version control.
NODE_ENV=production
PORT=4100
API_PUBLIC_URL=https://www.harmonydining.com.np
CORS_ORIGINS=https://www.harmonydining.com.np,https://harmonydining.com.np
# Compose supplies PGHOST/PGUSER/PGPASSWORD/PGDATABASE for the restricted account;
# docker-entrypoint.sh assembles DATABASE_URL.
# A deployment without Compose must set its own restricted account URL.
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=harmony_admin_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Initial provisioning only. Remove these values after creating the owner.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Harmony Owner
SEED_DEMO_CONTENT=false

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/storage/uploads
STORAGE_PUBLIC_BASE_URL=https://www.harmonydining.com.np/media

MAIL_DRIVER=smtp
MAIL_FROM="Harmony Dining <no-reply@harmonydining.com.np>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
LOG_LEVEL=info
