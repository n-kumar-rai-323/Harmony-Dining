# ------------------------------------------------------------------
# Harmony Restaurant API — environment
# Copy to .env for local development. Never commit real .env files.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4100

# Public origin of THIS API (used in emails, absolute media URLs, health)
API_PUBLIC_URL=http://localhost:4100

# Comma-separated list of allowed browser origins (CORS, credentials on).
# Public site + admin route group both run on the Next.js app.
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Matches docker-compose.yml for local dev.
DATABASE_URL=postgresql://harmony:harmony@localhost:5433/harmony?schema=public

# ---- Auth / sessions ----
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=12
# Cookie flags. In production set SESSION_COOKIE_SECURE=true and, if API and
# admin are on different domains, SESSION_COOKIE_SAMESITE=none.
SESSION_COOKIE_NAME=harmony_admin_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# First super admin — created by `pnpm db:seed` if it does not exist.
SEED_SUPERADMIN_EMAIL=owner@harmonydining.example
SEED_SUPERADMIN_PASSWORD=HarmonyAdmin2026  # no # or unquoted spaces in .env values
SEED_SUPERADMIN_NAME=Harmony Owner

# ---- Rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_SECONDS=300
AUTH_THROTTLE_LIMIT=10

# ---- Media storage ----
# driver: "local" (dev, writes to ./storage) or "s3" (prod: AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4100/media

# Only needed when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---- Email (SMTP) ----
# Failures are logged to mail_log and never roll back core data.
MAIL_DRIVER=log            # "log" (dev: no send, just record) or "smtp"
MAIL_FROM="Harmony Dining <no-reply@harmonydining.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Logging ----
LOG_LEVEL=info
