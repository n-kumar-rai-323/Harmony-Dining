# ------------------------------------------------------------------
# docker-compose.prod.yml — top-level variables.
# On the VPS: cp .env.example .env, then fill in real values.
# (Backend's own runtime secrets go in backend/.env.production — see there.)
# ------------------------------------------------------------------

# ---- Postgres (internal to the compose network, not exposed to the host) ----
POSTGRES_USER=harmony
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=harmony

# ---- Frontend build-time vars (baked into the browser bundle) ----
# Both must be the real public domain once you have one — not localhost.
NEXT_PUBLIC_API_URL=https://www.your-domain.example/api
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
