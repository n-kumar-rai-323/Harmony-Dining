# Public origin of the deployed site (no trailing slash).
# Used for canonical URLs, Open Graph tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.harmonydining.example

# Base URL of the Harmony backend API.
# Leave blank until the backend is deployed; forms fall back to
# their local-only confirmation state when this is unset.
NEXT_PUBLIC_API_URL=http://localhost:4100/api
